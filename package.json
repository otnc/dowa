{
  "name": "dowa",
  "version": "1.1.0",
  "description": "冷笑を検知しますw",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "types": "dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=14"
  },
  "scripts": {
    "setup": "npm install && node scripts/setup.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format && npm run lint:fix",
    "ci": "npm run format:check && npm run lint",
    "clean": "rimraf dist",
    "build": "tsdown",
    "deps:check": "ncu",
    "deps:up": "ncu -u && npm install"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/otnc/dowa.git"
  },
  "keywords": [
    "冷笑",
    "jp",
    "japanese",
    "regex",
    "regexp"
  ],
  "author": "otoneko.",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/otnc/dowa/issues"
  },
  "homepage": "https://github.com/otnc/dowa#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.3.2",
    "@vitest/coverage-v8": "^4.1.11",
    "consola": "^3.4.2",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "npm-check-updates": "^19.6.2",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
